---
import Logo from "./Logo.astro";
import { site } from "../data/site.js";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo-row">
        <Logo />
        <span>Oliver Hitchings</span>
      </div>
      <p>Practical automation for repeatable business tasks. Built to be inspected, operated, and changed.</p>
    </div>

    <div class="footer-links">
      <div>
        <h2>Site</h2>
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
      </div>
      <div>
        <h2>Updates</h2>
        <a href="/rss.xml">RSS</a>
      </div>
      <div>
        <h2>Contact</h2>
        <a href={site.cta.contact.href}>{site.cta.contact.label}</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; 2026 Oliver Hitchings</span>
    <span>Built for teams that want practical automation they can inspect.</span>
  </div>
</footer>
