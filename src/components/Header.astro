---
import Logo from "./Logo.astro";
import { site } from "../data/site.js";

const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <nav class="nav-pill" aria-label="Primary navigation">
    <a class="brand-mark" href="/" aria-label="Oliver Hitchings home">
      <Logo />
      <span>{site.name}</span>
    </a>
    <div class="nav-links">
      {
        links.map((link) => {
          const linkPath = link.href.replace(/\/$/, "") || "/";
          const isActive = currentPath === linkPath;
          return (
            <a href={link.href} aria-current={isActive ? "page" : undefined}>
              {link.label}
            </a>
          );
        })
      }
    </div>
    <a class="nav-cta" href={site.cta.contact.href}>{site.cta.contact.label}</a>
  </nav>
</header>
