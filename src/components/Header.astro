---
import Logo from './Logo.astro';

const path = Astro.url.pathname;
function isActive(href: string) {
	if (href === '/') return path === '/' || path === '';
	return path === href || path === href + '/' || path.startsWith(href + '/');
}
---

<nav class="cinema-nav">
	<div class="pill">
		<a href="/" class="brand" aria-label="Oliver Hitchings home">
			<Logo size={28} fill="white" />
		</a>
		<div class="links">
			<a href="/blog" class:list={[{ active: isActive('/blog') }]} aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
			<a href="/services" class:list={[{ active: isActive('/services') }]} aria-current={isActive('/services') ? 'page' : undefined}>Work with me</a>
			<a href="/about" class:list={[{ active: isActive('/about') }]} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
			<a href="/now" class:list={[{ active: isActive('/now') }]} aria-current={isActive('/now') ? 'page' : undefined}>Now</a>
		</div>
		<a href="/services" class="gradient-border-btn cta">Get started</a>
	</div>
</nav>

<style>
	.cinema-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: flex;
		justify-content: center;
		padding: 1.5rem 1.5rem 0;
		pointer-events: none;
	}
	.pill {
		pointer-events: auto;
		display: flex;
		align-items: center;
		gap: 2rem;
		background: rgba(10, 10, 10, 0.7);
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;
		padding: 0.6rem 0.6rem 0.6rem 1.5rem;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
	}
	.pill .brand {
		display: flex;
		align-items: center;
	}
	.pill .links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.pill .links a {
		font-size: 0.875rem;
		font-weight: 500;
		color: #a1a1aa;
		transition: color 0.15s ease;
		text-decoration: none;
		position: relative;
		padding: 0.25rem 0;
	}
	.pill .links a:hover {
		color: #fff;
	}
	.pill .links a.active {
		color: #fff;
	}
	.pill .links a.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -4px;
		height: 1px;
		background: var(--gradient);
		border-radius: 1px;
	}
	.pill .cta {
		font-size: 0.875rem;
		padding: 0.5rem 1.2rem;
	}
	@media (max-width: 720px) {
		.pill {
			gap: 0.75rem;
			padding: 0.5rem 0.5rem 0.5rem 1rem;
		}
		.pill .links {
			display: none;
		}
	}
</style>
