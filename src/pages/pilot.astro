---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

const title = 'The £2k AI Automation Pilot | Oliver Hitchings';
const description =
	'Stop paying smart people to copy, paste, chase updates, and build the same reports every week. Five useful business automations in two weeks.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body data-theme="cinematic">
		<Header />

		<main class="pilot-page">
			<section class="pilot-hero">
				<div class="glow glow-one"></div>
				<div class="glow glow-two"></div>
				<div class="pilot-container hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">The £2k AI Automation Pilot</p>
						<h1>Stop paying smart people to copy, paste, chase updates, and build the same reports every week.</h1>
						<p class="lede">
							I build custom AI automations for small businesses drowning in reports,
							scheduling, support, inbox triage, and repeated updates.
						</p>
						<div class="proof-strip" aria-label="Pilot details">
							<span>5 automations</span>
							<span>2 weeks</span>
							<span>£2k fixed fee</span>
							<span>No SaaS lock-in</span>
						</div>
						<div class="hero-actions">
							<a class="primary-btn" href="#booking">Book a free 30-minute workflow call</a>
							<a class="secondary-btn" href="#examples">See example automations</a>
						</div>
					</div>

					<aside class="pilot-card" aria-label="Pilot summary">
						<div class="card-topline">Fixed-scope pilot</div>
						<div class="price">£2k</div>
						<p>Five practical automations, built around the tools your business already uses.</p>
						<ul>
							<li>Map the repetitive work</li>
							<li>Pick the five highest-value candidates</li>
							<li>Build, test, and hand them over</li>
							<li>You own the setup when we are done</li>
						</ul>
						<a class="card-cta" href="#booking">Check if your workflows are a fit</a>
					</aside>
				</div>
			</section>

			<section class="pilot-section">
				<div class="pilot-container split">
					<div>
						<p class="eyebrow">Who this is for</p>
						<h2>Businesses with capable people wasting time on repeated admin.</h2>
					</div>
					<div class="plain-copy">
						<p>
							If your team sends the same updates, checks the same dashboards, copies the same data,
							or chases the same answers every week, the Pilot is designed to remove that drag.
						</p>
						<p>
							This is not an “AI transformation” programme. It is two weeks of practical engineering
							focused on boring work that should not need a human every time.
						</p>
					</div>
				</div>
			</section>

			<section class="pilot-section" id="examples">
				<div class="pilot-container">
					<div class="section-heading">
						<p class="eyebrow">Automation examples</p>
						<h2>Examples of work I can automate.</h2>
						<p>
							These are the kinds of jobs I look for on the workflow call. Small, dull things.
							Done reliably. Every day.
						</p>
					</div>

					<div class="example-grid">
						<div class="example-card"><h3>Daily reports</h3><p>Pull the numbers, summarise what changed, and send the result where your team already looks.</p></div>
						<div class="example-card"><h3>Weekly status updates</h3><p>Collect updates from tools and docs, then turn them into a clean Friday summary.</p></div>
						<div class="example-card"><h3>Inbox triage</h3><p>Sort messages, highlight urgent work, draft replies, and stop good leads getting buried.</p></div>
						<div class="example-card"><h3>Support ticket summaries</h3><p>Summarise customer issues, spot repeat problems, and prepare handover notes.</p></div>
						<div class="example-card"><h3>Customer follow-ups</h3><p>Spot who needs chasing and draft the next message without sending anything automatically.</p></div>
						<div class="example-card"><h3>Meeting prep</h3><p>Pull notes, recent emails, open tasks, and relevant context before a call.</p></div>
						<div class="example-card"><h3>Competitor monitoring</h3><p>Watch selected sites, feeds, and public updates, then tell you what changed.</p></div>
						<div class="example-card"><h3>Staff reminders</h3><p>Turn recurring checks into calm reminders instead of owner-led nagging.</p></div>
						<div class="example-card"><h3>Spreadsheet checks</h3><p>Find missing fields, odd numbers, stale rows, and tasks that need attention.</p></div>
						<div class="example-card"><h3>“Tell me what changed” alerts</h3><p>Compare reports, pages, trackers, or docs and send only the meaningful differences.</p></div>
					</div>
				</div>
			</section>

			<section class="pilot-section">
				<div class="pilot-container">
					<div class="section-heading">
						<p class="eyebrow">How the Pilot works</p>
						<h2>Two weeks. Five automations. Clear handover.</h2>
					</div>
					<div class="steps">
						<div class="step"><span>01</span><h3>Workflow call</h3><p>We list the repeated work and choose the strongest automation candidates.</p></div>
						<div class="step"><span>02</span><h3>Build week</h3><p>I build the first working versions and test them against real examples.</p></div>
						<div class="step"><span>03</span><h3>Refine week</h3><p>We tighten the output, remove rough edges, and agree what should stay human-approved.</p></div>
						<div class="step"><span>04</span><h3>Handover</h3><p>You get the setup, the runbook, and a plain-English explanation of how it works.</p></div>
					</div>
				</div>
			</section>

			<section class="pilot-section booking-section" id="booking">
				<div class="pilot-container booking-grid">
					<div>
						<p class="eyebrow">Book the workflow call</p>
						<h2>Check if your workflows are a fit.</h2>
						<p>
							Tell me where the repeated admin lives. The form opens a pre-filled email so you can
							review everything before sending. No CRM. No tracker. No automatic spam machine.
						</p>
						<div class="booking-note">
							<strong>Good fit:</strong> repeated reports, inbox triage, customer follow-ups, ops checks,
							spreadsheet reviews, and weekly summaries.
						</div>
					</div>

					<form class="booking-form" id="pilot-booking-form">
						<label class="hidden-field" aria-hidden="true">
							<span>Website</span>
							<input name="website" tabindex="-1" autocomplete="off" />
						</label>
						<label>
							<span>Name</span>
							<input name="name" autocomplete="name" required />
						</label>
						<label>
							<span>Company</span>
							<input name="company" autocomplete="organization" required />
						</label>
						<label>
							<span>Email</span>
							<input name="email" type="email" autocomplete="email" required />
						</label>
						<label>
							<span>Team size</span>
							<select name="teamSize" required>
								<option value="">Select one</option>
								<option>1–5</option>
								<option>6–20</option>
								<option>21–50</option>
								<option>51–100</option>
								<option>100+</option>
							</select>
						</label>
						<label class="full">
							<span>What repeated task is wasting the most time?</span>
							<textarea name="pain" rows="4" required placeholder="Example: Every Monday someone spends two hours pulling numbers from three systems and writing the same update."></textarea>
						</label>
						<label class="full">
							<span>What tools does your team already use?</span>
							<input name="tools" placeholder="Email, Slack, Teams, CRM, sheets…" />
						</label>
						<label class="full">
							<span>What would fixing this save?</span>
							<textarea name="value" rows="3" placeholder="Hours per week, fewer missed leads, faster reporting, less owner involvement…"></textarea>
						</label>
						<button type="submit"><span class="long-cta">Book a free 30-minute workflow call</span><span class="short-cta">Book workflow call</span></button>
						<p class="form-footnote" id="pilot-form-status">This securely validates the enquiry first. If lead delivery is not configured yet, it opens a reviewed email draft instead.</p>
					</form>
				</div>
			</section>
		</main>

		<script>
			const form = document.querySelector('#pilot-booking-form');
			const status = document.querySelector('#pilot-form-status');

			function fallbackMailto(data) {
				const lines = [
					'The £2k AI Automation Pilot enquiry',
					'',
					`Name: ${data.get('name') || ''}`,
					`Company: ${data.get('company') || ''}`,
					`Email: ${data.get('email') || ''}`,
					`Team size: ${data.get('teamSize') || ''}`,
					'',
					'What repeated task is wasting the most time?',
					`${data.get('pain') || ''}`,
					'',
					'Tools already used:',
					`${data.get('tools') || ''}`,
					'',
					'What would fixing this save?',
					`${data.get('value') || ''}`,
				].join('\n');
				const subject = encodeURIComponent('AI Automation Pilot workflow call');
				const body = encodeURIComponent(lines);
				window.location.href = `mailto:hello@oliverhitchings.com?subject=${subject}&body=${body}`;
			}

			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const data = new FormData(form);
				const button = form.querySelector('button');
				button?.setAttribute('disabled', 'true');
				if (status) status.textContent = 'Checking the enquiry…';

				try {
					const response = await fetch('/api/pilot-enquiry', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify(Object.fromEntries(data)),
					});
					const result = await response.json();
					if (!response.ok || !result.ok) throw new Error(result.error || 'Form unavailable');
					if (result.delivered) {
						if (status) status.textContent = 'Enquiry sent. Oliver will review it and reply.';
						form.reset();
						return;
					}
					if (result.mailto) {
						if (status) status.textContent = 'Opening a reviewed email draft…';
						window.location.href = result.mailto;
						return;
					}
				} catch (error) {
					if (status) status.textContent = 'Opening a reviewed email draft instead…';
					fallbackMailto(data);
				} finally {
					button?.removeAttribute('disabled');
				}
			});
		</script>
	</body>
</html>

<style>
	.pilot-page {
		width: 100%;
		max-width: none;
		padding: 0;
		margin: 0;
		background:
			radial-gradient(circle at 20% 10%, rgba(94, 234, 212, 0.14), transparent 28rem),
			radial-gradient(circle at 80% 0%, rgba(245, 158, 11, 0.16), transparent 30rem),
			#020203;
		color: var(--text);
		overflow: hidden;
	}
	.pilot-container {
		width: min(1120px, calc(100% - 2rem));
		margin: 0 auto;
	}
	.pilot-hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: flex-start;
		padding: 9rem 0 5rem;
	}
	.glow {
		position: absolute;
		filter: blur(70px);
		opacity: 0.45;
		pointer-events: none;
	}
	.glow-one {
		width: 22rem;
		height: 22rem;
		background: #14b8a6;
		top: 8rem;
		left: -8rem;
	}
	.glow-two {
		width: 26rem;
		height: 26rem;
		background: #f59e0b;
		right: -10rem;
		bottom: 0;
	}
	.hero-grid,
	.booking-grid,
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		gap: 3rem;
		align-items: center;
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: 0.78rem;
		font-weight: 700;
	}
	.hero-copy h1,
	.section-heading h2,
	.split h2,
	.booking-grid h2 {
		font-size: clamp(2.4rem, 6vw, 5.9rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
		margin: 0;
		max-width: 930px;
	}
	.split h2,
	.booking-grid h2,
	.section-heading h2 {
		font-size: clamp(2.2rem, 4vw, 4.6rem);
	}
	.lede {
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.45;
		max-width: 720px;
		color: var(--text-muted);
		margin: 1.6rem 0;
	}
	.proof-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin: 2rem 0;
	}
	.proof-strip span,
	.card-topline {
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.06);
		border-radius: 999px;
		padding: 0.5rem 0.85rem;
		color: var(--text-bright);
		font-size: 0.9rem;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 2.3rem;
	}
	.primary-btn,
	.secondary-btn,
	.card-cta,
	.booking-form button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		padding: 0.9rem 1.25rem;
		font-weight: 700;
		text-decoration: none;
	}
	.primary-btn,
	.card-cta,
	.booking-form button {
		background: var(--gradient);
		color: white;
		border: 0;
		box-shadow: 0 18px 45px rgba(245, 158, 11, 0.18);
	}
	.secondary-btn {
		border: 1px solid rgba(255, 255, 255, 0.16);
		color: var(--text-bright);
		background: rgba(255, 255, 255, 0.05);
	}
	.pilot-card,
	.booking-form,
	.example-card,
	.step,
	.booking-note {
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(12, 12, 15, 0.78);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.35);
	}
	.pilot-card {
		border-radius: 2rem;
		padding: 2rem;
		position: relative;
	}
	.price {
		font-size: 5rem;
		line-height: 1;
		font-weight: 800;
		letter-spacing: -0.07em;
		color: white;
		margin-top: 1.2rem;
	}
	.pilot-card p,
	.plain-copy,
	.section-heading p,
	.booking-grid p {
		color: #b8b8c2;
	}
	.pilot-card ul {
		padding: 0;
		margin: 1.6rem 0;
		list-style: none;
	}
	.pilot-card li {
		padding: 0.6rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		color: var(--text-bright);
	}
	.pilot-section {
		padding: 6rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.plain-copy {
		font-size: 1.1rem;
		line-height: 1.7;
	}
	.section-heading {
		max-width: 820px;
		margin-bottom: 2rem;
	}
	.example-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 1rem;
	}
	.example-card {
		border-radius: 1.4rem;
		padding: 1.25rem;
		min-height: 190px;
	}
	.example-card h3,
	.step h3 {
		font-size: 1.1rem;
		margin-bottom: 0.8rem;
	}
	.example-card p,
	.step p {
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0;
	}
	.steps {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}
	.step {
		border-radius: 1.4rem;
		padding: 1.35rem;
	}
	.step span {
		display: inline-block;
		color: var(--accent);
		font-weight: 800;
		margin-bottom: 1.4rem;
	}
	.booking-section {
		padding-bottom: 8rem;
	}
	.booking-note {
		border-radius: 1.2rem;
		padding: 1rem;
		margin-top: 1.5rem;
		color: var(--text-muted);
	}
	.booking-form {
		border-radius: 1.7rem;
		padding: 1.5rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.booking-form label {
		display: grid;
		gap: 0.4rem;
	}
	.hidden-field {
		display: none !important;
	}
	.booking-form label.full,
	.booking-form button,
	.form-footnote {
		grid-column: 1 / -1;
	}
	.booking-form span {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-bright);
	}
	.booking-form input,
	.booking-form textarea,
	.booking-form select {
		width: 100%;
		border-radius: 0.9rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(0, 0, 0, 0.28);
		color: var(--text-bright);
		padding: 0.85rem 0.9rem;
		font: inherit;
	}
	.booking-form textarea {
		resize: vertical;
	}
	.booking-form button {
		cursor: pointer;
		font-size: 1rem;
	}
	.short-cta {
		display: none;
	}
	.form-footnote {
		font-size: 0.85rem;
		color: var(--text-faint);
		margin: 0;
		text-align: center;
	}
	@media (max-width: 980px) {
		.hero-grid,
		.booking-grid,
		.split {
			grid-template-columns: 1fr;
		}
		.example-grid,
		.steps {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 640px) {
		.pilot-hero {
			padding-top: 7rem;
		}
		.example-grid,
		.steps,
		.booking-form {
			grid-template-columns: 1fr;
		}
		.hero-actions a {
			width: 100%;
		}
		.price {
			font-size: 4rem;
		}
		.long-cta {
			display: none;
		}
		.short-cta {
			display: inline;
		}
	}
</style>
