---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';

const lastUpdated = new Date('2026-04-16');
const title = 'Now';
const description = 'What Oliver Hitchings is working on right now — updated monthly.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="eyebrow">/ now</span>
				<h1>What I&rsquo;m doing right now</h1>
				<p class="lede">
					A snapshot of what has my attention this month &mdash; the projects, the reading, the
					experiments. Updated roughly monthly. Inspired by <a
						href="https://nownownow.com/about"
						target="_blank"
						rel="noopener">Derek Sivers&rsquo; /now movement</a
					>.
				</p>
				<span class="updated">Last updated <FormattedDate date={lastUpdated} /></span>
			</section>

			<div class="section">
				<h2>Building</h2>
				<ul>
					<li>
						<strong>OpenClaw</strong> &mdash; my autonomous AI platform on a Mac Mini. Currently
						tightening the agent-drift detection cron and migrating the memory layer off SQLite.
					</li>
					<li>
						<strong>This site</strong> &mdash; just shipped it. Writing about AI agents, Claude Code,
						Codex, OpenClaw, and the future of working.
					</li>
					<li>
						<strong>Taking on first AI-agent contracting clients</strong> &mdash; helping small UK
						businesses replace repetitive operational work with custom agents. <a href="/services"
							>Details on the services page</a
						>.
					</li>
				</ul>
			</div>

			<div class="section">
				<h2>Reading and watching</h2>
				<ul>
					<li>
						Anthropic&rsquo;s Claude Agent SDK docs &mdash; thinking about what shifts in agent design.
					</li>
					<li>
						Following the Hugging Face new-model feed daily &mdash; small open models keep getting
						good fast.
					</li>
					<li>
						Reading <em>The Innermost Loop</em> on Substack for the longer-form AI engineering takes.
					</li>
				</ul>
			</div>

			<div class="section">
				<h2>Where</h2>
				<p>UK, Europe/London. Available remote globally, on-site in the UK.</p>
			</div>

			<div class="section">
				<h2>What I&rsquo;m saying no to</h2>
				<ul>
					<li>Anything that requires me to use a model I can&rsquo;t reason about.</li>
					<li>
						SaaS-only architectures when a local-first version would do the job at 1/10 the cost.
					</li>
					<li>Speaking gigs, for now.</li>
				</ul>
			</div>

			<div class="note">
				This page is intentionally short. If you want the longer story, the <a href="/about"
					>about page</a
				> is the place. If you want to work together, see <a href="/services">services</a>.
			</div>
		</main>
		<Footer />

		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 7rem 1em 4rem;
			}
			.hero {
				padding: 0 0 2.5em;
				border-bottom: 1px solid var(--border);
				margin-bottom: 3em;
			}
			.eyebrow {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--accent);
				background: var(--accent-soft);
				padding: 0.3em 0.7em;
				border-radius: 999px;
				margin-bottom: 1.2em;
				letter-spacing: 0.02em;
			}
			.hero h1 {
				font-size: 2.4em;
				margin: 0 0 0.5em;
				line-height: 1.1;
				letter-spacing: -0.03em;
				color: var(--text-bright);
			}
			.hero .lede {
				font-size: 1.05rem;
				color: var(--text-muted);
				margin: 0 0 1em;
				max-width: 36em;
				line-height: 1.6;
			}
			.updated {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--text-faint);
			}
			.section {
				margin: 2.5em 0;
			}
			.section h2 {
				font-size: 0.78rem;
				font-family: var(--font-mono);
				color: var(--text-faint);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				margin: 0 0 1em;
			}
			.section ul {
				margin: 0;
				padding-left: 1.2em;
				list-style: none;
			}
			.section ul li {
				position: relative;
				margin-bottom: 0.8em;
				color: var(--text);
				line-height: 1.6;
			}
			.section ul li::before {
				content: '—';
				position: absolute;
				left: -1.2em;
				color: var(--text-faint);
			}
			.section p {
				margin: 0 0 1em;
				color: var(--text);
			}
			.section strong {
				color: var(--text-bright);
			}
			.note {
				margin-top: 4em;
				padding: 1.4em 1.6em;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 12px;
				font-size: 0.95rem;
				color: var(--text-muted);
			}
			@media (max-width: 720px) {
				main {
					padding: 6rem 1em 2rem;
				}
				.hero h1 {
					font-size: 1.8em;
				}
			}
		</style>
	</body>
</html>
