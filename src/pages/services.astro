---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";
---

<BaseLayout
  title="Services | Oliver Hitchings"
  description="Automation mapping, focused builds, and handover packages for repeatable business tasks."
>
  <main class="subpage">
    <section class="container subpage-hero-grid">
      <div class="subpage-hero">
        <p class="eyebrow">Services</p>
        <h1>Clear packages for turning repeat tasks into working systems.</h1>
        <p>
          Start with a mapped task, a focused build, or a wider operating system. Each option has a
          defined outcome, visible pricing, and a practical handover.
        </p>
        <div class="cta-row left">
          <a class="button" href="#packages">View packages</a>
          <a class="button ghost" href="/about">How I work</a>
        </div>
      </div>
      <div class="visual-panel">
        <video src="/videos/process.mp4" autoplay muted loop playsinline preload="metadata"></video>
        <div>
          <span>01</span>
          <strong>Map, build, hand over</strong>
        </div>
      </div>
    </section>

    <section class="container service-list">
      <article>
        <span>01</span>
        <h2>Map the task</h2>
        <p>Find the inputs, failure points, source systems, approvals, and the simplest useful shape.</p>
      </article>
      <article>
        <span>02</span>
        <h2>Build the loop</h2>
        <p>Create the first reliable version with prompts, scripts, logs, schedules, and operator controls.</p>
      </article>
      <article>
        <span>03</span>
        <h2>Operational handover</h2>
        <p>Document the setup, train the owner, and leave a path for future changes and debugging.</p>
      </article>
    </section>

    <section id="packages" class="container package-section">
      <div class="section-heading">
        <p class="eyebrow">Prices and packages</p>
        <h2>Pick the size of the first step.</h2>
      </div>
      <div class="package-grid">
        <article class="package-card">
          <p class="eyebrow">Fixed scope</p>
          <h3>Task Map</h3>
          <p class="price">£250</p>
          <p>
            Best when you know something should be automated, but the exact build shape is still
            unclear. This turns one repeat task into a scoped plan.
          </p>
          <ul>
            <li>One discovery session</li>
            <li>Current process, owner, inputs, and output map</li>
            <li>Failure points, approval moments, and edge cases</li>
            <li>Recommended build shape, tools, and next-step estimate</li>
          </ul>
          <a class="button ghost" href="#contact">Enquire</a>
        </article>
        <article class="package-card featured">
          <p class="eyebrow">Most common</p>
          <h3>First Build</h3>
          <p class="price">£500</p>
          <p>
            A focused first implementation for one use case. The aim is to prove the task can run
            with useful controls before it becomes part of the business.
          </p>
          <ul>
            <li>Task map and implementation plan</li>
            <li>Working automation using real inputs and outputs</li>
            <li>Prompts, logs, review rules, and failure handling</li>
            <li>Run guide plus two review sessions after first use</li>
          </ul>
          <a class="button" href="#contact">Start here</a>
        </article>
        <article class="package-card">
          <p class="eyebrow">Larger build</p>
          <h3>Operator System</h3>
          <p class="price">£1,000</p>
          <p>
            For work that has more than one step, owner, or system involved. This creates a more
            complete operating setup around the automation.
          </p>
          <ul>
            <li>Multiple task paths or departments</li>
            <li>Monitoring, alerts, reporting, and exception handling</li>
            <li>Documentation, owner training, and change notes</li>
            <li>30-day improvement period after launch</li>
          </ul>
          <a class="button ghost" href="#contact">Discuss scope</a>
        </article>
      </div>
      <p class="package-note">
        Prices are guide prices for May 2026. VAT, third-party software, model usage, and hosting
        are separate if they apply.
      </p>
      <div class="retainer-strip">
        <div>
          <p class="eyebrow">Optional retainer</p>
          <h3>Ongoing support from £100/month</h3>
          <p>
            For teams that want a light monthly support layer after launch: monitoring, small
            improvements, fixes, usage checks, and one review call.
          </p>
        </div>
        <a class="button ghost" href="#contact">Add support</a>
      </div>
    </section>

    <section id="contact" class="container proof-panel contact-panel">
      <p class="eyebrow">Start the conversation</p>
      <h2>Send the task you want removed from the week.</h2>
      <p>
        Useful detail: what happens now, which tools are involved, who checks the output, and what a
        good result would look like.
      </p>
      <form class="contact-form" action="/api/contact" method="POST" data-contact-form>
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="form-grid">
          <label>
            <span>Name</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            <span>Contact number</span>
            <input name="contact_number" type="tel" autocomplete="tel" />
          </label>
          <label>
            <span>Package interest</span>
            <select name="package_interest" required>
              <option value="">Choose one</option>
              <option>Task Map</option>
              <option>First Build</option>
              <option>Operator System</option>
              <option>Ongoing support</option>
              <option>Not sure yet</option>
            </select>
          </label>
        </div>

        <label>
          <span>What do you want automated?</span>
          <textarea
            name="automation_request"
            rows="5"
            required
            placeholder="Tell me the repeat task, who handles it now, and what a good result would look like."
          ></textarea>
        </label>

        <label>
          <span>Tools or systems involved</span>
          <textarea
            name="tools_involved"
            rows="3"
            placeholder="For example: Gmail, Outlook, Sheets, Notion, Slack, CRM, website forms, internal docs."
          ></textarea>
        </label>

        <button class="button" type="submit">Send enquiry</button>
        <p class="form-status" data-contact-status>
          This sends the enquiry directly from the website to {site.email}.
        </p>
      </form>
    </section>

    <section class="container detail-section">
      <div>
        <p class="eyebrow">Good-fit tasks</p>
        <h2>Best for work that is frequent, structured, and annoying.</h2>
      </div>
      <div class="detail-grid">
        <article>
          <h3>Inbox and intake triage</h3>
          <p>Classify, route, summarize, and prepare responses while keeping the final send under human control.</p>
        </article>
        <article>
          <h3>Research and monitoring</h3>
          <p>Watch sources, deduplicate results, score importance, and produce a short decision-ready brief.</p>
        </article>
        <article>
          <h3>Reporting loops</h3>
          <p>Collect recurring inputs, check them for gaps, and produce a consistent operational report.</p>
        </article>
        <article>
          <h3>Internal coordination</h3>
          <p>Turn meeting notes, tickets, calendars, and docs into follow-ups that do not rely on memory.</p>
        </article>
      </div>
    </section>

    <section class="container visual-split">
      <div class="visual-panel wide">
        <video src="/videos/feature-card.mp4" autoplay muted loop playsinline preload="metadata"></video>
        <div>
          <span>Live system shape</span>
          <strong>Prompts, logs, controls, and owner notes kept visible.</strong>
        </div>
      </div>
    </section>

    <section class="container proof-panel">
      <p class="eyebrow">What you leave with</p>
      <h2>A working setup, not a dependency.</h2>
      <p>
        The deliverable includes the task map, prompts, run commands, logs, review rules, failure
        states, and a short operator guide. The point is simple: your team should understand what
        the system does and how to change it.
      </p>
    </section>

  </main>

  <script>
    const contactForm = document.querySelector("[data-contact-form]");
    const contactStatus = document.querySelector("[data-contact-status]");

    contactForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        return;
      }

      const formData = new FormData(contactForm);

      if (formData.get("_honey")) {
        return;
      }

      if (contactStatus) {
        contactStatus.textContent = "Sending enquiry...";
      }

      const submitButton = contactForm.querySelector("button[type='submit']");

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Sending...";
      }

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(Object.fromEntries(formData.entries())),
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.message || "The enquiry could not be sent. Please try again.");
        }

        contactForm.reset();

        if (contactStatus) {
          contactStatus.textContent = "Sent. I will reply to your enquiry as soon as I can.";
        }
      } catch (error) {
        if (contactStatus) {
          contactStatus.textContent =
            error instanceof Error
              ? error.message
              : "The enquiry could not be sent. Please try again.";
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Send enquiry";
        }
      }
    });
  </script>
</BaseLayout>
