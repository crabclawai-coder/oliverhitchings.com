---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';

const title = 'AI agents, built for your business — Oliver Hitchings';
const description =
	'I help small businesses replace repetitive operational work with custom AI agents — built locally, owned by you.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body data-theme="cinematic">
		<Header />

		<!-- ============================================================
		     1. HERO
		     ============================================================ -->
		<main class="hero">
			<video
				class="hero-bg"
				src="/videos/hero.mp4"
				autoplay
				muted
				loop
				playsinline
				preload="auto"></video>
			<div class="hero-fade"></div>

			<div class="hero-content">
				<span class="eyebrow animate-float-up">work with me</span>
				<h1 class="animate-float-up hero-headline">
					AI agents,<br />
					built for<br />
					<span class="muted">your business</span>
				</h1>

				<p class="animate-float-up-delay hero-lede">
					I sit with your team, find the workflows eating their day, and replace them with custom
					agents you actually understand and own. Local-first. No SaaS lock-in.
				</p>

				<div class="animate-float-up-delay-3 hero-badge">
					<div class="badge-pill">
						<Logo size={28} fill="white" />
						<span class="badge-text">Free 30-min discovery call</span>
						<svg
							class="badge-svg"
							viewBox="0 0 28 28"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<defs>
								<linearGradient id="ring-grad-svc" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#F59E0B" />
									<stop offset="100%" stop-color="#3B82F6" />
								</linearGradient>
							</defs>
							<circle cx="14" cy="14" r="11" stroke="#3f3f46" stroke-width="3" fill="none"></circle>
							<circle
								class="spin-ring"
								cx="14"
								cy="14"
								r="11"
								stroke="url(#ring-grad-svc)"
								stroke-width="3"
								fill="none"
								stroke-dasharray="18 100"
								stroke-linecap="round"></circle>
						</svg>
					</div>
				</div>
			</div>
		</main>

		<!-- ============================================================
		     2. STATS GRID
		     ============================================================ -->
		<section class="stats">
			<div class="stats-inner cinema-container">
				<div class="stat">
					<div class="stat-num">3</div>
					<div class="stat-label">Step process</div>
				</div>
				<div class="stat">
					<div class="stat-num">2&ndash;6</div>
					<div class="stat-label">Weeks typical</div>
				</div>
				<div class="stat">
					<div class="stat-num">$0</div>
					<div class="stat-label">Monthly recurring</div>
				</div>
				<div class="stat last">
					<div class="stat-num">100%</div>
					<div class="stat-label">Yours after handover</div>
				</div>
			</div>
			<div class="stats-banner">Free discovery call &middot; Fixed-scope, fixed-price builds</div>
		</section>

		<!-- ============================================================
		     3. FEATURE BLOCK
		     ============================================================ -->
		<section class="feature">
			<div class="feature-inner cinema-container">
				<div class="feature-text">
					<h2 class="feature-headline">
						Master your<br />
						<span class="muted">team&rsquo;s workflows</span>
					</h2>
					<p class="feature-copy">
						Most businesses have 5&ndash;15 recurring rituals that quietly eat senior time every day
						&mdash; morning reports, queue triage, status compiles, monitoring. Each one is an
						agent waiting to be built.
					</p>
					<a class="gradient-border-btn feature-btn" href="#process">How it works</a>
				</div>

				<div class="feature-card">
					<div class="feature-card-glow"></div>
					<div class="feature-card-inner">
						<video
							src="/videos/feature-card.mp4"
							autoplay
							muted
							loop
							playsinline
							preload="metadata"></video>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     4. SCROLL-SCRUBBED SECTION
		     ============================================================ -->
		<section class="process" id="process-section">
			<div class="process-bg">
				<video
					id="process-video"
					src="/videos/process.mp4"
					muted
					playsinline
					preload="auto"></video>
				<div class="process-fade-top"></div>
				<div class="process-fade-bottom"></div>
			</div>

			<div class="process-content cinema-container">
				<h2 class="animate-float-up process-headline">
					Where workflows<br />
					get rebuilt
				</h2>
				<p class="animate-float-up-delay process-sub">
					From your team&rsquo;s daily friction to a working agent in 2&ndash;6 weeks. You own the
					code, the prompts, the cost.
				</p>
				<a
					href="mailto:oliverhit2008@gmail.com?subject=AI agents for my business"
					class="animate-float-up-delay-3 process-btn">Get in touch</a
				>
			</div>
		</section>

		<!-- ============================================================
		     5. BENTO GRID (the 3 steps)
		     ============================================================ -->
		<section class="bento" id="process">
			<div class="bento-inner cinema-container">
				<h2 class="bento-header">How it <span class="muted">works</span></h2>

				<div class="bento-grid">
					<!-- Step 01 -->
					<div class="bento-card">
						<div class="bento-card-bg">
							<video
								src="/videos/bento.mp4"
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								style="object-position: top;"></video>
							<div class="bento-fade"></div>
						</div>
						<div class="bento-card-content">
							<div class="step-num">01</div>
							<h3>Audit</h3>
							<p>
								Half-day deep dive into how your team actually spends its time. I leave with a
								written list of what an agent could realistically take off your plate.
							</p>
							<span class="step-note">Free. No commitment.</span>
						</div>
					</div>

					<!-- Step 02 -->
					<div class="bento-card">
						<div class="bento-card-bg">
							<video
								src="/videos/bento.mp4"
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								style="object-position: center;"></video>
							<div class="bento-fade"></div>
						</div>
						<div class="bento-card-content">
							<div class="step-num">02</div>
							<h3>Build</h3>
							<p>
								Custom agents wired into the tools you already use &mdash; email, Slack, your CRM,
								your spreadsheets. Working software in 2&ndash;6 weeks.
							</p>
							<span class="step-note">Fixed scope. Fixed price.</span>
						</div>
					</div>

					<!-- Step 03 (wide) -->
					<div class="bento-card bento-card-wide">
						<div class="bento-card-bg">
							<video
								src="/videos/bento.mp4"
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								style="object-position: bottom;"></video>
							<div class="bento-fade"></div>
						</div>
						<div class="bento-card-content">
							<div class="step-num">03</div>
							<h3>Handover</h3>
							<p>
								You own the code, the agents, the workflows, the docs. I train one of your team to
								maintain it. No black box, no monthly SaaS lock-in, no &ldquo;but what happens if
								Oliver disappears.&rdquo;
							</p>
							<span class="step-note">Optional retainer for ongoing tuning.</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     5b. WHO THIS IS FOR
		     ============================================================ -->
		<section class="fit">
			<div class="fit-inner cinema-container">
				<h2 class="fit-header">Who this is <span class="muted">for</span></h2>
				<div class="fit-grid">
					<div class="fit-col yes">
						<h3>Good fit</h3>
						<ul>
							<li>You&rsquo;re a 10&ndash;100 person business doing real operational work.</li>
							<li>Your team is drowning in admin, scheduling, support, or reporting.</li>
							<li>You want to own what you build, not rent it forever.</li>
							<li>You&rsquo;re comfortable being early &mdash; this is genuinely new territory.</li>
						</ul>
					</div>
					<div class="fit-col no">
						<h3>Not a fit</h3>
						<ul>
							<li>You want a chatbot for your website (cheaper tools exist for that).</li>
							<li>You need enterprise compliance, SOC 2, dedicated TAMs.</li>
							<li>You want someone to white-label OpenAI and call it AI strategy.</li>
							<li>You&rsquo;re not ready to give an AI access to real systems.</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     5c. WHY ME
		     ============================================================ -->
		<section class="why">
			<div class="why-inner cinema-container">
				<h2 class="why-header">Why <span class="muted">me</span></h2>
				<div class="why-grid">
					<div class="why-card">
						<div class="why-num">10+</div>
						<div class="why-label">Years in IT engineering</div>
						<p>I&rsquo;ve worked inside business systems before AI was the answer to anything. I know what an integration actually costs to maintain.</p>
					</div>
					<div class="why-card">
						<div class="why-num">5</div>
						<div class="why-label">Autonomous agents I run daily</div>
						<p>OpenClaw runs five specialised agents on a Mac Mini and Mac Studio in my home office &mdash; coding, orchestration, reasoning, workflows, auditing.</p>
					</div>
					<div class="why-card">
						<div class="why-num">40+</div>
						<div class="why-label">Cron jobs running 24/7</div>
						<p>Morning briefs, market watchlists, security audits, vault gardening. Real automation I trust enough to wake up to. <a href="/blog">See how they work &rarr;</a></p>
					</div>
					<div class="why-card">
						<div class="why-num">$0</div>
						<div class="why-label">Monthly cloud spend</div>
						<p>Local-first by default. Qwen3.6 for the routine, Codex/Claude for the heavy lifting. You get the same architecture for your business.</p>
					</div>
				</div>
				<p class="why-coda">
					Based in the UK, available remote globally or on-site across the UK.
				</p>
			</div>
		</section>

		<!-- ============================================================
		     5d. FAQ
		     ============================================================ -->
		<section class="faq">
			<div class="faq-inner cinema-container">
				<h2 class="faq-header">Frequently <span class="muted">asked</span></h2>
				<div class="faq-list">
					<details class="faq-item" open>
						<summary>What does this typically cost?</summary>
						<p>
							Audits are free. Builds are fixed-scope, fixed-price &mdash; we agree the deliverable
							and the number before we start. Most projects land between &pound;3k and &pound;15k
							depending on scope and integration complexity. No retainers required, no hourly
							meters running.
						</p>
					</details>
					<details class="faq-item">
						<summary>Where do my agents actually run?</summary>
						<p>
							Default is on a machine you own &mdash; usually a small Mac Mini or a
							dedicated VM &mdash; with local models doing the routine work. When something
							needs more horsepower, the agent calls out to Codex or Claude through your own
							OpenAI / Anthropic account. You see every API call. You can pull the plug
							whenever you want.
						</p>
					</details>
					<details class="faq-item">
						<summary>What happens if you disappear / move on?</summary>
						<p>
							You own the code, the prompts, the docs, the deployment. I train one of your
							team during handover so the system isn&rsquo;t a black box. Optional retainer
							for ongoing tuning at a flat monthly rate, but you&rsquo;re never forced into
							it.
						</p>
					</details>
					<details class="faq-item">
						<summary>How long does a build take?</summary>
						<p>
							Most projects ship in 2&ndash;6 weeks from kickoff. Audit is half a day. Build
							is the bulk. Handover plus a week of supervised running is the tail.
						</p>
					</details>
					<details class="faq-item">
						<summary>Can you work with my existing tools?</summary>
						<p>
							Yes &mdash; that&rsquo;s usually the brief. Slack, email, Google Workspace,
							Microsoft 365, your CRM, your spreadsheets, your bespoke internal apps. If it
							has an API or a script-able interface, an agent can use it. If it doesn&rsquo;t,
							we figure out a workaround in the audit.
						</p>
					</details>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     6. COMBINED CTA + FOOTER
		     ============================================================ -->
		<section class="combined" id="combined-section">
			<div class="combined-bg">
				<video
					id="combined-video"
					src="/videos/cta-footer.mp4"
					muted
					playsinline
					preload="auto"></video>
				<div class="combined-fade"></div>
			</div>

			<div class="cta-block">
				<div class="cta-inner cinema-container">
					<div class="cta-logo-box animate-float-up">
						<Logo size={40} fill="white" />
					</div>

					<h2 class="animate-float-up cta-headline">
						Ready to talk?
					</h2>

					<p class="animate-float-up-delay cta-copy">
						Email me one paragraph about your business and what&rsquo;s eating your team&rsquo;s
						time. If it sounds like a fit, I&rsquo;ll book a free discovery call.
					</p>

					<div class="animate-float-up-delay-3 cta-buttons">
						<a
							class="cta-primary"
							href="mailto:oliverhit2008@gmail.com?subject=AI agents for my business&body=Hi Oliver,%0D%0A%0D%0AAbout my business: %0D%0A%0D%0AWhat's eating my team's time: %0D%0A%0D%0A"
							>Email me</a
						>
						<a class="cta-secondary" href="/blog">Read the blog</a>
					</div>
				</div>
			</div>

			<footer class="cinema-footer">
				<div class="cinema-footer-inner cinema-container">
					<div class="footer-top">
						<div class="footer-brand">
							<div class="brand-row">
								<Logo size={28} fill="white" />
								<span class="brand-text">OLIVER HITCHINGS</span>
							</div>
							<p class="brand-tagline">
								AI agents for real businesses. Built locally. Owned by you.
							</p>
						</div>

						<div class="footer-columns">
							<div>
								<h4>Site</h4>
								<a href="/">Home</a>
								<a href="/services">Services</a>
								<a href="/about">About</a>
								<a href="/now">Now</a>
							</div>
							<div>
								<h4>Writing</h4>
								<a href="/blog">Blog</a>
								<a href="/rss.xml">RSS</a>
								<a href="https://github.com/CanYouLikeNot" target="_blank" rel="noopener"
									>GitHub</a
								>
							</div>
							<div>
								<h4>Contact</h4>
								<a href="mailto:oliverhit2008@gmail.com">Email</a>
								<a href="https://github.com/CanYouLikeNot" target="_blank" rel="noopener"
									>GitHub</a
								>
							</div>
						</div>
					</div>

					<div class="footer-bottom">
						<span class="copyright">&copy; 2026 Oliver Hitchings. All rights reserved.</span>
						<div class="socials">
							<a href="https://github.com/CanYouLikeNot" target="_blank" rel="noopener">GITHUB</a>
							<a href="mailto:oliverhit2008@gmail.com">EMAIL</a>
						</div>
					</div>
				</div>
			</footer>
		</section>

		<script>
			import { initScrollScrubbedVideos, scrubFallback } from '../scripts/scroll-video';

			const pairs: { video: HTMLVideoElement; container: HTMLElement }[] = [];

			const processVideo = document.getElementById('process-video') as HTMLVideoElement | null;
			const processSection = document.getElementById('process-section') as HTMLElement | null;
			if (processVideo && processSection) pairs.push({ video: processVideo, container: processSection });

			const combinedVideo = document.getElementById('combined-video') as HTMLVideoElement | null;
			const combinedSection = document.getElementById('combined-section') as HTMLElement | null;
			if (combinedVideo && combinedSection)
				pairs.push({ video: combinedVideo, container: combinedSection });

			if (pairs.length > 0) {
				initScrollScrubbedVideos(pairs);
				scrubFallback(pairs.map((p) => p.video));
			}
		</script>

		<style>
			.muted {
				color: #71717a;
			}

			/* ===== HERO ===== */
			.hero {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: flex-start;
				padding: 140px 1.5rem 6rem;
				text-align: center;
				min-height: 100vh;
				overflow: hidden;
			}
			.hero-bg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				pointer-events: none;
				z-index: 0;
				transform: scale(1.5) translateY(25%) rotate(-36deg);
				opacity: 1;
			}
			.hero-fade {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				height: 33%;
				background: linear-gradient(to top, #000, transparent);
				z-index: 10;
				pointer-events: none;
			}
			.hero-content {
				position: relative;
				z-index: 20;
				display: flex;
				flex-direction: column;
				align-items: center;
			}
			.eyebrow {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: #fff;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.15);
				padding: 0.35em 0.9em;
				border-radius: 999px;
				margin-bottom: 1.5em;
				letter-spacing: 0.05em;
			}
			.hero-headline {
				font-size: 60px;
				line-height: 1.05;
				letter-spacing: -0.04em;
				font-weight: 600;
				color: #fff;
				max-width: 700px;
				margin: 0;
			}
			.hero-lede {
				margin-top: 2rem;
				font-size: 1.125rem;
				color: #a1a1aa;
				max-width: 480px;
				line-height: 1.6;
			}
			.hero-badge {
				margin-top: 4rem;
			}
			.badge-pill {
				background: rgba(24, 24, 27, 0.8);
				backdrop-filter: blur(24px);
				border-radius: 20px;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
				border: 1px solid #27272a;
				padding: 1rem 1.5rem;
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.badge-text {
				font-size: 0.875rem;
				font-weight: 500;
				color: #e4e4e7;
				white-space: nowrap;
			}
			.badge-svg {
				width: 1.75rem;
				height: 1.75rem;
			}
			@media (max-width: 720px) {
				.hero-headline {
					font-size: 40px;
				}
				.badge-text {
					font-size: 0.75rem;
				}
			}

			/* ===== STATS ===== */
			.stats {
				position: relative;
				z-index: 20;
				background: #000;
				border-top: 1px solid #27272a;
				border-bottom: 1px solid #27272a;
			}
			.stats-inner {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
			}
			.stat {
				padding: 3rem;
				border-right: 1px solid #27272a;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.stat.last {
				border-right: none;
			}
			.stat-num {
				font-size: 3rem;
				font-weight: 600;
				letter-spacing: -0.02em;
				color: #fff;
			}
			.stat-label {
				font-size: 0.75rem;
				color: #71717a;
				text-transform: uppercase;
				letter-spacing: 0.15em;
			}
			.stats-banner {
				text-align: center;
				padding: 1.5rem 1rem;
				border-top: 1px solid #27272a;
				font-size: 0.75rem;
				color: #52525b;
				text-transform: uppercase;
				letter-spacing: 0.3em;
			}
			@media (max-width: 900px) {
				.stats-inner {
					grid-template-columns: repeat(2, 1fr);
				}
				.stat {
					border-right: 1px solid #27272a;
					border-bottom: 1px solid #27272a;
					padding: 2rem 1.5rem;
				}
				.stat:nth-child(2),
				.stat:nth-child(4) {
					border-right: none;
				}
				.stat-num {
					font-size: 2.5rem;
				}
			}

			/* ===== FEATURE ===== */
			.feature {
				position: relative;
				z-index: 20;
				padding: 8rem 0;
				background: #000;
			}
			.feature-inner {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 5rem;
				align-items: center;
			}
			.feature-headline {
				font-size: 60px;
				line-height: 1.05;
				letter-spacing: -0.04em;
				font-weight: 600;
				margin: 0 0 2rem;
				color: #fff;
			}
			.feature-copy {
				font-size: 1.125rem;
				color: #a1a1aa;
				max-width: 28em;
				line-height: 1.6;
				margin-bottom: 2.5rem;
			}
			.feature-btn {
				padding: 0.8rem 2rem;
			}
			.feature-card {
				position: relative;
			}
			.feature-card-glow {
				position: absolute;
				inset: -1rem;
				background: linear-gradient(to right, rgba(245, 158, 11, 0.2), rgba(59, 130, 246, 0.2));
				border-radius: 32px;
				filter: blur(40px);
				opacity: 0.5;
				transition: opacity 0.5s ease;
				pointer-events: none;
			}
			.feature-card:hover .feature-card-glow {
				opacity: 1;
			}
			.feature-card-inner {
				position: relative;
				background: rgba(24, 24, 27, 0.8);
				backdrop-filter: blur(24px);
				border: 1px solid #27272a;
				border-radius: 32px;
