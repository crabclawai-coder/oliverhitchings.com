---
import BaseLayout from "../layouts/BaseLayout.astro";
import { posts } from "../data/site.js";

const postVideos = ["/videos/feature-card.mp4", "/videos/process.mp4", "/videos/bento.mp4"];
---

<BaseLayout
  title="Blog | Oliver Hitchings"
  description="Field notes and practical writing about automation, operations, and handover."
>
  <main class="subpage">
    <section class="container subpage-hero-grid">
      <div class="subpage-hero">
        <p class="eyebrow">Blog</p>
        <h1>Field notes from building useful automation.</h1>
        <p>
          Short notes on task design, owned infrastructure, first builds, and the operational details
          that make automation useful after the demo.
        </p>
      </div>
      <div class="visual-panel">
        <video src="/videos/cta-footer.mp4" autoplay muted loop playsinline preload="metadata"></video>
        <div>
          <span>Notes</span>
          <strong>Practical writing from the build process.</strong>
        </div>
      </div>
    </section>

    <section class="container blog-grid">
      {
        posts.map((post, index) => (
          <article class="blog-card">
            <video src={postVideos[index % postVideos.length]} autoplay muted loop playsinline preload="metadata"></video>
            <p class="eyebrow">{post.category}</p>
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p>{post.summary}</p>
            <a class="text-link" href={`/blog/${post.slug}`}>Read note</a>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>
