---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import { site } from "../data/site.js";
---

<BaseLayout>
  <main>
    <section class="hero">
      <video class="hero-video" src="/videos/hero.mp4" autoplay muted loop playsinline preload="auto"></video>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <a class="availability" href="/services#packages">
          <span></span>
          {site.availability}
        </a>
        <h1>AI automation your team can <span>actually own</span></h1>
        <p>
          I turn regular back-office jobs into small, inspectable systems: clear inputs, review
          points, logs, and a handover your team can use.
        </p>
        <div class="hero-actions">
          <a class="button" href="/services#packages">{site.cta.primary}</a>
          <a class="button ghost" href="#home-pricing">See prices</a>
          <div class="ops-badge">
            <Logo />
            <span>Useful systems, clear ownership, human review</span>
          </div>
        </div>
      </div>
    </section>

    <section class="split-section home-intro-section">
      <div class="container split-grid">
        <div>
          <p class="eyebrow">Built to be understood</p>
          <h2>It runs where you can see it.</h2>
        </div>
        <div class="copy-stack">
          <p>
            The work is set up with readable prompts, simple run commands, useful logs, and clear
            review points. When a step needs stronger reasoning, that decision is deliberate and
            recorded.
          </p>
          <p class="pull-line">Small, dull things. Done reliably.</p>
        </div>
      </div>
    </section>

    <section class="feature-section">
      <div class="container feature-grid">
        <div class="feature-copy">
          <p class="eyebrow">Service design</p>
          <h2>Replace repeat admin with <span>working tools</span></h2>
          <p>
            I sit with your team, map the task, define the failure points, and build a narrow system
            that is readable enough for a human to own after handover.
          </p>
          <a class="button" href="/services">See services</a>
        </div>
        <div class="media-card">
          <video src="/videos/feature-card.mp4" autoplay muted loop playsinline preload="metadata"></video>
        </div>
      </div>
    </section>

    <section id="home-pricing" class="container package-section home-packages">
      <div class="section-heading">
        <p class="eyebrow">Prices and packages</p>
        <h2>Start small, then build what proves itself.</h2>
      </div>
      <div class="package-grid compact">
        <article class="package-card">
          <p class="eyebrow">Fixed scope</p>
          <h3>Task Map</h3>
          <p class="price">£250</p>
          <p>
            A short mapping sprint for one repeat task: current steps, inputs, owners, failure
            points, tools involved, and a clear build recommendation.
          </p>
          <a class="button ghost" href="/services#contact">Enquire</a>
        </article>
        <article class="package-card featured">
          <p class="eyebrow">Most common</p>
          <h3>First Build</h3>
          <p class="price">£500</p>
          <p>
            A narrow working version for one use case, built with real inputs, review points, logs,
            prompts, and a handover guide your team can follow.
          </p>
          <a class="button" href="/services#contact">Start enquiry</a>
        </article>
        <article class="package-card">
          <p class="eyebrow">Larger build</p>
          <h3>Operator System</h3>
          <p class="price">£1,000</p>
          <p>
            A more complete setup for connected steps, with stronger controls, reporting, exception
            handling, documentation, and owner training.
          </p>
          <a class="button ghost" href="/services#contact">Discuss scope</a>
        </article>
      </div>
      <div class="retainer-strip">
        <div>
          <p class="eyebrow">Optional retainer</p>
          <h3>Ongoing support from £100/month</h3>
          <p>Monthly monitoring, small improvements, fixes, and one review call after the build is live.</p>
        </div>
        <a class="button ghost" href="/services#contact">Ask about support</a>
      </div>
    </section>

    <section class="stats-section">
      <div class="container stats-grid">
        <div>
          <strong>40+</strong>
          <span>Internal automations already running</span>
        </div>
        <div>
          <strong>1</strong>
          <span>Workflow selected before anything is built</span>
        </div>
        <div>
          <strong>3</strong>
          <span>Handover assets: prompts, logs, and runbook</span>
        </div>
        <div>
          <strong>£100/mo</strong>
          <span>Optional support after launch</span>
        </div>
      </div>
      <p class="proof-strip">Designed for the people who have to run it</p>
    </section>

    <section class="process-section">
      <video class="process-video" src="/videos/process.mp4" autoplay muted loop playsinline preload="metadata"></video>
      <div class="process-overlay"></div>
      <div class="container process-content">
        <h2>One painful task becomes a working loop</h2>
        <p>
          The first build is intentionally narrow: real inputs, real outputs, review points, logs,
          and enough failure handling to decide whether it belongs in the business.
        </p>
        <a class="button" href="/services#packages">See packages</a>
      </div>
    </section>

    <section class="operator-section">
      <div class="container">
        <p class="eyebrow">Operating layer</p>
        <h2>Built for <span>repeat use</span></h2>
        <div class="operator-grid">
          <article>
            <video src="/videos/bento.mp4" autoplay muted loop playsinline preload="metadata"></video>
            <div>
              <h3>Inspect everything</h3>
              <p>The important pieces stay visible: prompts, schedules, logs, scripts, and runbooks.</p>
            </div>
          </article>
          <article>
            <video src="/videos/process.mp4" autoplay muted loop playsinline preload="metadata"></video>
            <div>
              <h3>Honest engineering</h3>
              <p>Every assumption is visible. No mystery costs, no vague claims, no fragile handover.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <video src="/videos/cta-footer.mp4" autoplay muted loop playsinline preload="metadata"></video>
      <div class="final-cta-overlay"></div>
      <div class="container final-cta-content">
        <Logo size={42} />
        <h2>Start with one task that already hurts.</h2>
        <p>
          If your team has repeat work that follows a pattern, I can help you test whether a small
          owned system should take it on.
        </p>
        <div class="cta-row">
          <a class="button" href="/services#packages">{site.cta.primary}</a>
          <a class="button ghost" href="/services">{site.cta.secondary}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
