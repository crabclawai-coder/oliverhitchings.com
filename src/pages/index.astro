---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 3);

const pillars = [
	{
		title: 'AI agents',
		blurb:
			'What an agent actually is in 2026, what they can do today, and where they break.',
	},
	{
		title: 'OpenClaw',
		blurb:
			'My local-first autonomous AI platform running natively on a Mac Mini. $0 cloud cost, full control.',
	},
	{
		title: 'Claude Code',
		blurb:
			'Anthropic\u2019s coding agent as a daily driver \u2014 workflows, hooks, sub-agents, the lot.',
	},
	{
		title: 'Codex',
		blurb:
			'OpenAI\u2019s Codex CLI via free ChatGPT OAuth. Surprisingly good. Surprisingly free.',
	},
	{
		title: 'The future of working',
		blurb:
			'When every engineer has ten agents, what does a job look like? Notes from the inside.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3.5em 0 2.5em;
				border-bottom: 1px solid var(--border);
				margin-bottom: 3em;
			}
			.eyebrow {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.78em;
				color: var(--accent);
				background: var(--accent-soft);
				padding: 0.3em 0.7em;
				border-radius: 999px;
				margin-bottom: 1.2em;
				letter-spacing: 0.02em;
			}
			.hero h1 {
				font-size: 2.6em;
				margin: 0 0 0.5em;
				line-height: 1.05;
			}
			.hero p.lede {
				font-size: 1.2em;
				color: rgb(var(--gray));
				margin: 0;
				max-width: 36em;
			}
			.handle {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin-top: 1em;
			}
			.section-title {
				font-size: 0.85em;
				font-family: var(--font-mono);
				color: rgb(var(--gray));
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				margin: 2.2em 0 1em;
			}
			.pillars {
				display: grid;
				gap: 1em;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				margin-bottom: 3em;
			}
			.pillar {
				padding: 1.4em;
				border: 1px solid var(--border);
				border-radius: 12px;
				background: var(--surface);
				transition:
					transform 0.15s ease,
					border-color 0.15s ease;
			}
			.pillar:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
			}
			.pillar h3 {
				margin: 0 0 0.4em;
				font-size: 1.05em;
			}
			.pillar p {
				margin: 0;
				font-size: 0.94em;
				color: rgb(var(--gray));
				line-height: 1.5;
			}
			.posts {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.posts li {
				padding: 1em 0;
				border-bottom: 1px solid var(--border);
			}
			.posts li:last-child {
				border-bottom: none;
			}
			.posts a {
				text-decoration: none;
				color: inherit;
				display: flex;
				justify-content: space-between;
				gap: 1em;
				align-items: baseline;
			}
			.posts a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				font-weight: 600;
			}
			.post-date {
				font-family: var(--font-mono);
				font-size: 0.82em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.see-all {
				display: inline-block;
				margin-top: 1.2em;
				font-size: 0.95em;
				text-decoration: none;
			}
			.work-cta {
				margin-top: 3.5em;
				padding: 2em;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 14px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5em;
				flex-wrap: wrap;
			}
			.work-cta-text strong {
				display: block;
				margin-bottom: 0.2em;
				font-size: 1.05em;
			}
			.work-cta-text span {
				color: rgb(var(--gray));
				font-size: 0.95em;
			}
			.work-cta a.btn {
				display: inline-block;
				background: rgb(var(--black));
				color: var(--bg) !important;
				padding: 0.7em 1.3em;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95em;
				white-space: nowrap;
				transition: background 0.15s ease;
			}
			.work-cta a.btn:hover {
				background: var(--accent);
				color: white !important;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="eyebrow">oliver hitchings</span>
				<h1>Building with AI agents.<br />Writing about what works.</h1>
				<p class="lede">
					I&rsquo;m an IT engineer in the UK. I run an autonomous AI platform called OpenClaw on a Mac
					Mini in my flat and use Claude Code and Codex every day. This site is where I share what I
					learn &mdash; and where I help businesses do the same.
				</p>
				<span class="handle">@CanYouLikeNot &middot; UK</span>
			</section>

			<h2 class="section-title">What I write about</h2>
			<div class="pillars">
				{
					pillars.map((p) => (
						<div class="pillar">
							<h3>{p.title}</h3>
							<p>{p.blurb}</p>
						</div>
					))
				}
			</div>

			<h2 class="section-title">Latest posts</h2>
			<ul class="posts">
				{
					latest.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-title">{post.data.title}</span>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<a class="see-all" href="/blog">All posts &rarr;</a>

			<div class="work-cta">
				<div class="work-cta-text">
					<strong>Need AI agents for your business?</strong>
					<span
						>I help small businesses replace repetitive operational work with custom AI agents.</span
					>
				</div>
				<a class="btn" href="/services">Work with me &rarr;</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
