---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";
---

<BaseLayout>
  <main class="home-page">
    <section class="home-hero">
      <video
        class="home-hero__video"
        src="/videos/hero.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      ></video>
      <div class="home-hero__scrim"></div>

      <div class="container home-hero__content">
        <div class="home-hero__copy">
          <div class="home-hero__kicker">
            <p class="eyebrow">Oliver Hitchings · Automation systems</p>
            <a class="availability" href="/services#packages">
              <span></span>
              {site.availability}
            </a>
          </div>
          <h1>Small automation systems your team can inspect and own.</h1>
          <p class="home-hero__intro">
            I turn repeat business work into controlled loops with clear inputs, human review,
            visible logs and a practical handover.
          </p>
          <div class="hero-actions">
            <a class="button" href="/services#contact">Start an enquiry</a>
            <a class="button ghost" href="#packages">View packages</a>
          </div>
        </div>

        <aside class="operator-trace" aria-label="Operator trace">
          <div class="operator-trace__header">
            <span>Controlled loop</span>
            <span>04 states</span>
          </div>
          <ol>
            <li data-trace-state="input">
              <span class="trace-code">IN.01</span>
              <div>
                <strong>Input</strong>
                <p>repeat task or source material enters the loop</p>
              </div>
            </li>
            <li data-trace-state="review">
              <span class="trace-code">HUMAN</span>
              <div>
                <strong>Review</strong>
                <p>a person checks uncertain or consequential steps</p>
              </div>
            </li>
            <li data-trace-state="action">
              <span class="trace-code">RUN.01</span>
              <div>
                <strong>Action</strong>
                <p>the approved next step runs</p>
              </div>
            </li>
            <li data-trace-state="evidence">
              <span class="trace-code">LOG.01</span>
              <div>
                <strong>Evidence</strong>
                <p>result or failure state logged</p>
              </div>
            </li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="proof-rail" aria-label="Verified delivery facts">
      <div class="container proof-rail__grid">
        <div data-proof-item>
          <strong>1</strong>
          <p>One workflow is selected before a build begins.</p>
        </div>
        <div data-proof-item>
          <strong>3</strong>
          <p>Build handover assets: prompts, logs and a runbook.</p>
        </div>
      </div>
    </section>

    <section class="container editorial-section loop-section" data-reveal>
      <div class="editorial-heading">
        <div>
          <p class="eyebrow">From repeat task to owned loop</p>
          <h2>The build follows the work, not the other way round.</h2>
        </div>
        <p class="editorial-intro">
          The aim is not to automate everything. It is to make one repeatable path clear enough to
          run, inspect and change.
        </p>
      </div>

      <ol class="loop-sequence">
        <li data-loop-stage>
          <h3><span>01</span> Intake</h3>
          <p>trigger, source material, expected output</p>
        </li>
        <li data-loop-stage>
          <h3><span>02</span> Classify</h3>
          <p>explicit rules before model interpretation</p>
        </li>
        <li data-loop-stage>
          <h3><span>03</span> Human review</h3>
          <p>pause where confidence is low or consequences matter</p>
        </li>
        <li data-loop-stage>
          <h3><span>04</span> Action</h3>
          <p>run only the approved next step</p>
        </li>
        <li data-loop-stage>
          <h3><span>05</span> Evidence</h3>
          <p>record what happened, failed, or needs attention</p>
        </li>
      </ol>
    </section>

    <section class="editorial-section pattern-section" data-patterns data-reveal>
      <div class="container pattern-layout">
        <div class="pattern-heading">
          <p class="eyebrow">Example system patterns</p>
          <h2>Three useful shapes for repeat work.</h2>
          <p class="pattern-disclosure">
            These are example system patterns, not client case studies.
          </p>
        </div>

        <div class="pattern-rows">
          <article data-pattern>
            <span>EX.01</span>
            <div>
              <h3>Inbox triage</h3>
              <p>
                Classify, route and prepare for review; final sending stays with a person.
              </p>
            </div>
          </article>
          <article data-pattern>
            <span>EX.02</span>
            <div>
              <h3>Research monitoring</h3>
              <p>Monitor named sources, remove duplicates and prepare a review queue.</p>
            </div>
          </article>
          <article data-pattern>
            <span>EX.03</span>
            <div>
              <h3>Recurring reporting</h3>
              <p>
                Collect scheduled inputs, flag gaps and prepare a consistent report with a source
                trail.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="packages" class="container editorial-section package-ledger" data-reveal>
      <div class="editorial-heading compact-heading">
        <div>
          <p class="eyebrow">Packages</p>
          <h2>Choose the smallest useful first step.</h2>
        </div>
        <p class="editorial-intro">
          Start with the amount of definition the task needs now. Each package keeps scope and
          ownership visible.
        </p>
      </div>

      <div class="package-ledger__rows">
        <article class="package-row">
          <div class="package-row__title">
            <p class="eyebrow">Fixed scope</p>
            <h3>Task Map</h3>
          </div>
          <p class="price">£250</p>
          <p class="package-row__description">
            One repeat task mapped into steps, inputs, owners, failure points and a clear build
            recommendation.
          </p>
          <a class="button ghost" href="/services#contact">Enquire about Task Map</a>
        </article>
        <article class="package-row">
          <div class="package-row__title">
            <p class="eyebrow">Focused implementation</p>
            <h3>First Build</h3>
          </div>
          <p class="price">£500</p>
          <p class="package-row__description">
            A narrow working loop using real inputs, review points, prompts, logs and a practical
            handover.
          </p>
          <a class="button ghost" href="/services#contact">Enquire about First Build</a>
        </article>
        <article class="package-row">
          <div class="package-row__title">
            <p class="eyebrow">Connected workflow</p>
            <h3>Operator System</h3>
          </div>
          <p class="price">£1,000</p>
          <p class="package-row__description">
            A wider operating setup for connected steps, monitoring, exceptions, documentation and
            owner training.
          </p>
          <a class="button ghost" href="/services#contact">Enquire about Operator System</a>
        </article>
        <article class="package-row package-row--support">
          <div class="package-row__title">
            <p class="eyebrow">Optional retainer</p>
            <h3>Ongoing support</h3>
          </div>
          <p class="price">from £100/month</p>
          <p class="package-row__description">
            A light monthly layer for monitoring, small improvements, fixes, usage checks and one
            review call.
          </p>
          <a class="button ghost" href="/services#contact">Enquire about ongoing support</a>
        </article>
      </div>

      <p class="package-note">
        Guide prices. VAT, third-party software, model usage and hosting are separate where they
        apply.
      </p>
    </section>

    <section
      class="container editorial-section principles-section"
      data-operating-principles
    >
      <div class="editorial-heading compact-heading">
        <div>
          <p class="eyebrow">Operating principles</p>
          <h2>A system should make sense on a bad day.</h2>
        </div>
      </div>

      <div class="principle-rows">
        <article>
          <h3>Inspectability</h3>
          <p>Visible prompts, rules, assumptions and logs.</p>
        </article>
        <article>
          <h3>Failure handling</h3>
          <p>Retries, stop conditions and escalation.</p>
        </article>
        <article>
          <h3>Handover</h3>
          <p>Material needed to operate, review and change the system.</p>
        </article>
      </div>
    </section>

    <section class="home-final-cta">
      <div class="container home-final-cta__grid">
        <p class="eyebrow">Have a repeat task in mind?</p>
        <div>
          <h2>Send the task, the tools and the review point.</h2>
          <p>
            Tell me what happens now, where it gets stuck, who checks the result and what a useful
            output would look like.
          </p>
          <a class="button" href="/services#contact">Start an enquiry</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
