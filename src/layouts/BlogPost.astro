---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
							<div class="hero-overlay"></div>
						</div>
					)
				}
				<div class="prose">
					<header class="title">
						<div class="meta">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="updated"> · updated <FormattedDate date={updatedDate} /></span>
								)
							}
						</div>
						<h1>{title}</h1>
					</header>
					<div class="body">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />

		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 7rem 0 4rem;
			}
			.hero-image {
				position: relative;
				max-width: 1020px;
				margin: 0 auto 3rem;
				padding: 0 1rem;
			}
			.hero-image img {
				width: 100%;
				display: block;
				border-radius: 16px;
				border: 1px solid var(--border);
			}
			.hero-overlay {
				position: absolute;
				left: 1rem;
				right: 1rem;
				bottom: 0;
				height: 50%;
				background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.5));
				border-radius: 0 0 16px 16px;
				pointer-events: none;
			}
			.prose {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1em;
				color: var(--text);
				line-height: 1.75;
				font-size: 1.05rem;
			}
			.title {
				margin-bottom: 3em;
				padding: 1em 0 2em;
				text-align: left;
				border-bottom: 1px solid var(--border);
			}
			.meta {
				font-family: var(--font-mono);
				font-size: 0.82em;
				color: var(--text-faint);
				margin-bottom: 1em;
				letter-spacing: 0.02em;
			}
			.updated {
				color: var(--text-faint);
			}
			.title h1 {
				margin: 0;
				font-size: 2.6em;
				line-height: 1.1;
				letter-spacing: -0.03em;
				color: var(--text-bright);
			}
			.body :global(h2) {
				margin-top: 2.5em;
				margin-bottom: 0.6em;
				font-size: 1.6em;
				color: var(--text-bright);
			}
			.body :global(h3) {
				margin-top: 2em;
				margin-bottom: 0.5em;
				font-size: 1.25em;
				color: var(--text-bright);
			}
			.body :global(p) {
				margin: 0 0 1.4em;
				color: var(--text);
			}
			.body :global(ul),
			.body :global(ol) {
				margin: 0 0 1.4em;
				padding-left: 1.4em;
			}
			.body :global(li) {
				margin-bottom: 0.5em;
				color: var(--text);
			}
			.body :global(a) {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 3px;
				text-decoration-color: rgba(94, 234, 212, 0.4);
			}
			.body :global(a:hover) {
				color: var(--text-bright);
				text-decoration-color: var(--text-bright);
			}
			.body :global(blockquote) {
				border-left: 3px solid var(--accent);
				padding: 0.4em 0 0.4em 1.4em;
				margin: 2em 0;
				color: var(--text-muted);
				font-style: italic;
			}
			.body :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin: 1.5em 0;
				font-size: 0.95em;
			}
			.body :global(th),
			.body :global(td) {
				padding: 0.6em 0.8em;
				border-bottom: 1px solid var(--border);
				text-align: left;
			}
			.body :global(th) {
				font-weight: 600;
				color: var(--text-bright);
				border-bottom: 1px solid var(--border);
			}
			.body :global(hr) {
				border: none;
				border-top: 1px solid var(--border);
				margin: 3em 0;
			}
			@media (max-width: 720px) {
				main {
					padding: 6rem 0 2rem;
				}
				.title h1 {
					font-size: 2em;
				}
				.prose {
					font-size: 1rem;
				}
			}
		</style>
	</body>
</html>
