---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.js";
import "../styles/global.css";

const {
  title = site.name,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>
      const revealTargets = document.querySelectorAll(
        [
          ".stats-grid > div",
          ".proof-strip",
          ".retainer-strip > *",
          ".home-intro-section .eyebrow",
          ".home-intro-section h2",
          ".home-intro-section .copy-stack > *",
          ".feature-copy > *",
          ".media-card",
          ".process-content > *",
          ".operator-section > .container > .eyebrow",
          ".operator-section > .container > h2",
          ".operator-grid article",
          ".final-cta-content > *",
          ".subpage-hero-grid > *",
          ".service-list article",
          ".package-section .section-heading > *",
          ".package-card",
          ".detail-section > *",
          ".detail-grid article",
          ".proof-panel",
          ".feature-copy .button",
          ".process-content .button",
          ".final-cta-content .button",
          ".retainer-strip .button",
          ".blog-card",
          ".visual-panel",
        ].join(","),
      );

      revealTargets.forEach((target, index) => {
        target.classList.add("reveal");

        if (
          target.matches(".media-card, .visual-panel, .subpage-hero-grid > .visual-panel")
        ) {
          target.classList.add("reveal-from-right");
        } else if (
          target.matches(
            ".package-card, .stats-grid > div, .operator-grid article, .service-list article, .detail-grid article, .blog-card, .button",
          )
        ) {
          target.classList.add("reveal-pop");
        } else if (target.matches("h1, h2, .eyebrow")) {
          target.classList.add("reveal-from-left");
        } else {
          target.classList.add("reveal-up");
        }

        target.style.setProperty("--reveal-delay", `${Math.min(index % 6, 5) * 95}ms`);
      });

      if (!("IntersectionObserver" in window)) {
        revealTargets.forEach((target) => target.classList.add("is-visible"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
        );

        revealTargets.forEach((target) => revealObserver.observe(target));
      }
    </script>
  </body>
</html>
